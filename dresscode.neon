use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests

excludePaths:
	- tests/**/output
	- tests/tmp

fileExtensions:
	- php
	- phpt

imports:
	grouping:
		class: grouped

functions:
	namedBooleanArgument: required

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations
