{
	"name": "dg/butler",
	"description": "🤵 Butler: runs background tasks triggered by webhooks, cron or CLI. Verifies the caller, never lets a burst of requests pile up on a lock, and keeps tasks that touch real services out of local runs.",
	"keywords": ["task", "task-runner", "background-jobs", "webhook", "cron", "lock", "mutex", "flock", "nette"],
	"homepage": "https://butler.deegee.dev",
	"license": "MIT",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6"
	},
	"require-dev": {
		"nette/tester": "^2.6",
		"tracy/tracy": "^2.12",
		"phpstan/phpstan": "^2.3",
		"phpstan/extension-installer": "^1.4",
		"nette/phpstan-rules": "^1.0"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"Butler\\": "src"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		}
	}
}
